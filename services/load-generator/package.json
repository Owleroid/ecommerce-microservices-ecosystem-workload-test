{
  "name": "load-generator",
  "version": "1.0.0",
  "description": "Load testing tool for microservices ecosystem",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test:auth": "node dist/index.js --scenario auth --duration 60 --rps 10",
    "test:profile": "node dist/index.js --scenario profile --duration 60 --rps 5",
    "test:avatar": "node dist/index.js --scenario avatar --duration 60 --rps 2",
    "test:all": "node dist/index.js --scenario all --duration 120 --rps 5"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "commander": "^11.1.0",
    "form-data": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}

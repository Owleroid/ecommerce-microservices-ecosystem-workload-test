{
  "name": "ecommerce-microservices-ecosystem",
  "version": "1.0.0",
  "private": true,
  "description": "E-commerce microservices workload testing ecosystem",
  "workspaces": [
    "services/*",
    "shared/*"
  ],
  "scripts": {
    "dev:auth": "npm run dev --workspace=auth-service",
    "dev:user": "npm run dev --workspace=user-service",
    "dev:media": "npm run dev --workspace=media-service",
    "dev:gateway": "npm run dev --workspace=api-gateway",
    "build:all": "npm run build --workspace=service-common && npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/pg": "^8.16.0",
    "typescript": "^5.3.0"
  }
}
